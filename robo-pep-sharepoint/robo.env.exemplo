# Modelo das variáveis do robô. NÃO preencher este arquivo.
# Na máquina de desenvolvimento, a cópia preenchida fica FORA do repositório:
#   C:\Users\Maquina001\.pulsar-sharepoint\robo.env
# No Coolify, cada linha vira uma variável marcada como Secret.
# Passo a passo: docs/ROBO_PEP_SHAREPOINT_OPERACAO.md

AZURE_TENANT_ID=
AZURE_CLIENT_ID=
SHAREPOINT_SITE_ID=

# Máquina de desenvolvimento: caminhos. Coolify: *_B64 (conteúdo em base64).
SHAREPOINT_CERT_KEY_PATH=
SHAREPOINT_CERT_PATH=
SHAREPOINT_CERT_KEY_B64=
SHAREPOINT_CERT_B64=

SUPABASE_URL=
SUPABASE_ANON_KEY=
MACHINE_TOKEN=

# Só no container: segredo do "Executar agora" (o mesmo no app Pulsar).
ROBO_TRIGGER_SECRET=
# Horários em Brasília (UTC-3).
HORARIOS=03:00
# A execução agendada lê o site inteiro (padrão: sim). "nao" = só o que mudou.
LEITURA_COMPLETA_NA_AGENDA=sim
# Homologação: id da pasta de teste. Vazio = site inteiro.
SHAREPOINT_SOMENTE_PASTA=
PORT=8080
