              "nda",
              "programa_de_cuidado",
              "reabilitacao_cognitiva",
              "psicoeducacao"
            ]
          },
          "uniqueItems": true,
          "description": "3. SERVIÇO DE INTERESSE (pode ter mais de uma) — pode mais de uma. Card: multi."
        },
        "rota": {
          "type": [
            "string",
            "null"
