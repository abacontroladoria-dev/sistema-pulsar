    "tags": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origem": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "meta_ads",
            "google_ads",
            "google",
            "site",
            "linktree",
            "indicacao_medica",
            "indicacao_escola",
            "indicacao_amigo_familiar",
            "contato_direto",
            null
          ],
          "description": "1. ORIGEM — exatamente uma ou null. Card: single."
        },
        "tipo_de_contato": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "lead",
            "paciente_ativo",
            "nao_paciente_curso",
            "nao_paciente_trabalhe_conosco",
            "nao_paciente_parceria",
            "nao_paciente_advogado",
            "nao_paciente_real_saude",
            null
          ],
          "description": "2. TIPO DE CONTATO — exatamente uma ou null. Card: single."
        },
        "servico_de_interesse": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "avaliacao_inicial",
              "av_neuropsicologica_infantil",
              "av_neuropsicologica_adulto",
              "consulta_medica",
              "terapia_aba",
              "fonoaudiologia",
