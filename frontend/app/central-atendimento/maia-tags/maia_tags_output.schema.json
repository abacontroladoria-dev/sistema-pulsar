{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "maia_tags_output.schema.json",
  "title": "Saída de classificação da Maia",
  "description": "Objeto que a Maia devolve por turno. O backend valida contra este schema e contra o catálogo antes de gravar. Enums já excluem tags humano-only e o grupo jurídico.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tags",
    "campos",
    "escalar_humano"
  ],
